# Public origin of the deployed Worker, for example:
# BETTER_AUTH_URL=https://lexis-sanctuary.<your-subdomain>.workers.dev
BETTER_AUTH_URL=http://localhost:5173
CLOUDFLARE_D1_DATABASE_ID=<production-d1-database-uuid>

# Generate a high-entropy value (at least 32 characters).
BETTER_AUTH_SECRET=

# Google OAuth credentials. The callback URL is:
# <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Server-side only. Never prefix these with VITE_.
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
